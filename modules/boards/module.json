{
  "id": "brainstorm.boards",
  "label": "Boards",
  "version": "0.1.0",
  "summary": "Brainstorm's creative space: infinite whiteboards and moodboards to sketch, collect and group images, notes and links. Replaces Brainstorm's old Board and brings its cards across.",
  "entry": "/boards",
  "host": "iframe",
  "owns": {
    "tables": [
      "venia_boards",
      "venia_board_files"
    ],
    "buckets": [
      "venia-boards"
    ],
    "migrations": [
      "supabase/migrations/20261118_venia_boards.sql"
    ],
    "localStorage": [
      "venia-boards:*"
    ],
    "indexedDB": [
      "venia-boards"
    ]
  },
  "access": {
    "grant": "venia_members.module = 'brainstorm' (same grant as Brainstorm)",
    "roles": {
      "owner": "everything, including permanent delete",
      "editor": "create and change boards",
      "viewer": "look only"
    }
  },
  "uses": {
    "core": [
      "supabase session (same origin)",
      "venia_is_founder()",
      "venia_module_role(text)"
    ],
    "otherModules": [],
    "ownModuleData": [
      "venia_module_data row 'brainstorm', key 'board' (the old Board, read to bring its cards across; never written)"
    ]
  },
  "messages": {
    "toHost": [
      "boards:ready",
      "boards:title"
    ],
    "fromHost": [
      "host:theme"
    ]
  },
  "licence": {
    "canvas": "Excalidraw 0.18.1, MIT",
    "ui": "React 18, MIT",
    "storage": "@supabase/supabase-js, MIT"
  },
  "module": "brainstorm"
}
{
  "id": "brainstorm.boards",
  "module": "brainstorm",
  "version": "0.2.0",
  "label": "Boards",
  "summary": "Brainstorm's creative space: infinite whiteboards and moodboards to sketch, collect and group images, notes and links. Replaces Brainstorm's old Board and brings its cards across.",
  "screens": [
    {
      "id": "boards",
      "path": "/boards",
      "host": "iframe",
      "nav": {
        "label": "Boards",
        "order": 65
      }
    }
  ],
  "owns": {
    "tables": [
      "venia_boards",
      "venia_board_files",
      "venia_boards_purged"
    ],
    "buckets": [
      "venia-boards"
    ],
    "sqlFunctions": [
      "venia_boards_can(text)"
    ],
    "migrations": [
      "supabase/migrations/20261118_venia_boards.sql",
      "supabase/migrations/20261118_venia_boards_purged.sql"
    ],
    "indexedDB": [
      "venia-boards"
    ],
    "edgeFunctions": [
      "boards-purge"
    ]
  },
  "roles": [
    "viewer",
    "editor",
    "owner"
  ],
  "access": {
    "grant": "venia_members.module = 'brainstorm' (same grant as Brainstorm)",
    "roles": {
      "owner": "everything, including permanent delete",
      "editor": "create and change boards",
      "viewer": "look only"
    }
  },
  "requires": [
    "core.auth (Supabase session, same origin)",
    "core.access (venia_is_founder, venia_module_role)"
  ],
  "uses": {
    "ownModuleData": [
      "venia_module_data row 'brainstorm', key 'board' (the old Board, read to bring its cards across; never written)"
    ],
    "otherModules": []
  },
  "hostContract": {
    "transport": "window.postMessage, same origin only",
    "toHost": {
      "boards:ready": "{mode}",
      "boards:title": "{title}"
    },
    "fromHost": {}
  },
  "emits": [],
  "listens": [],
  "licence": {
    "canvas": "Excalidraw 0.18.1, MIT",
    "ui": "React 18, MIT",
    "storage": "@supabase/supabase-js, MIT"
  }
}
